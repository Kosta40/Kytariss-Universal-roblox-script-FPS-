-- ============ RENDER ============
RunService:BindToRenderStep("KytarissLock", Enum.RenderPriority.Camera.Value + 1, function(dt)
	for p, bb in pairs(labels) do
		if not isValidESP(p) then
			detachLabel(p)
		else
			local h = head(p)
			if h then
				local txt = bb:FindFirstChild("Dist")
				if txt then
					local d = (h.Position - cam.CFrame.Position).Magnitude
					txt.Text = string.format("%s [%d]", p.DisplayName, math.floor(d))
				end
			else
				detachLabel(p)
			end
		end
	end

	if boxOn then
		for p, frame in pairs(boxes) do
			local char = p.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local h = head(p)
			if not isValidESP(p) or not hrp or not h then
				frame.Visible = false
			else
				local topWorld = h.Position + Vector3.new(0, 0.5, 0)
				local bottomWorld = hrp.Position - Vector3.new(0, 3, 0)
				local topScreen, topOn = cam:WorldToViewportPoint(topWorld)
				local botScreen, botOn = cam:WorldToViewportPoint(bottomWorld)
				if topOn and botOn then
					local height = math.abs(botScreen.Y - topScreen.Y)
					local width = height * BOX_RATIO
					local cx = (topScreen.X + botScreen.X) / 2
					local cy = (topScreen.Y + botScreen.Y) / 2
					frame.Position = UDim2.fromOffset(cx, cy)
					frame.Size = UDim2.fromOffset(width, height)
					frame.Visible = true
				else
					frame.Visible = false
				end
			end
		end
	else
		for _, frame in pairs(boxes) do
			frame.Visible = false
		end
	end

	-- HEALTHBAR verticale à droite
	if healthOn then
		for p, container in pairs(healthbars) do
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local h = head(p)
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not isValidESP(p) or not hum or not h or not hrp then
				container.Visible = false
			else
				local topWorld = h.Position + Vector3.new(0, 0.5, 0)
				local bottomWorld = hrp.Position - Vector3.new(0, 3, 0)
				local topScreen, topOn = cam:WorldToViewportPoint(topWorld)
				local botScreen, botOn = cam:WorldToViewportPoint(bottomWorld)
				if topOn and botOn then
					local boxHeight = math.abs(botScreen.Y - topScreen.Y)
					local boxWidth = boxHeight * BOX_RATIO
					local cx = (topScreen.X + botScreen.X) / 2
					local topY = math.min(topScreen.Y, botScreen.Y)

					local barW = 4 * (HP_SCALE / 100)
					local barH = boxHeight

					local gap = 4
					local barX = cx + (boxWidth / 2) + gap
					local barY = topY

					container.Position = UDim2.fromOffset(barX, barY)
					container.Size = UDim2.fromOffset(barW, barH)
					container.Visible = true

					local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
					local fill = container:FindFirstChild("Fill")
					if fill then
						fill.Size = UDim2.new(1, 0, pct, 0)
						fill.Position = UDim2.new(0, 0, 0, 0)
						fill.BackgroundColor3 = Color3.new(1 - pct, pct, 0.2)
					end
				else
					container.Visible = false
				end
			end
		end
	else
		for _, c in pairs(healthbars) do c.Visible = false end
	end

	-- HOLD-LOCK
	if holdLocking then
		if not target then
			local p = closest()
			if p then
				rememberedTarget = p
				setTarget(p)
			end
		end

		if target then
			local h = head(target)
			if not h then
				holdMissingTime = holdMissingTime + dt
				if holdMissingTime > 0.8 then
					rememberedTarget = nil
					holdMissingTime = 0
					setTarget(nil)
					local p = closest()
					if p then
						rememberedTarget = p
						setTarget(p)
					end
				end
			else
				holdMissingTime = 0
				local pos = cam.CFrame.Position
				local alpha = SMOOTH > 0 and (1 - math.exp(-SMOOTH * dt)) or 1
				look = look:Lerp((h.Position - pos).Unit, alpha).Unit
				cam.CFrame = CFrame.lookAt(pos, pos + look)
			end
		end
		return
	end

	-- LOCK NORMAL
	if not target then return end

	if not isVisibleForLock(target) then
		setTarget(nil)
		return
	end

	local h = head(target)
	if not h then setTarget(nil) return end
	if not inFOV(h) then
		setTarget(nil)
		return
	end

	local pos = cam.CFrame.Position
	local alpha = SMOOTH > 0 and (1 - math.exp(-SMOOTH * dt)) or 1
	look = look:Lerp((h.Position - pos).Unit, alpha).Unit
	cam.CFrame = CFrame.lookAt(pos, pos + look)
end)

-- ============ LIFECYCLE ============
local function hookPlayer(p)
	local function onChar()
		task.wait(0.1)
		if p == lp then
			stopSpinBot()
			stopBunny()
			savedNeckC0 = nil
		end
		apply(p)
		attachLabel(p)
		if boxOn then attachBox(p) end
		if healthOn then attachHealth(p) end
		local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if hum and p == lp then
			hum.Died:Connect(function()
				stopSpinBot()
				stopBunny()
			end)
		end
	end
	if p.Character then task.spawn(onChar) end
	p.CharacterAdded:Connect(onChar)
end

for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(function(p)
	if highlights[p] then highlights[p]:Destroy() highlights[p] = nil end
	detachLabel(p)
	detachBox(p)
	detachHealth(p)
	if p == target then setTarget(nil) end
	if p == rememberedTarget then rememberedTarget = nil end
end)

