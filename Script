-- ============ UNLOCK MOUSE (NEW) ============
local function unlockMouse()
	if mouseUnlocked then return end
	mouseUnlocked = true
	savedMouseBehavior = UIS.MouseBehavior
	savedMouseIcon = UIS.MouseIconEnabled

	UIS.MouseBehavior = Enum.MouseBehavior.Default
	UIS.MouseIconEnabled = true
	refreshUI()
end

local function lockMouse()
	if not mouseUnlocked then return end
	mouseUnlocked = false

	-- Restaure le comportement original (généralement LockCenter en FPS)
	if savedMouseBehavior then
		UIS.MouseBehavior = savedMouseBehavior
	else
		UIS.MouseBehavior = Enum.MouseBehavior.Default
	end
	if savedMouseIcon ~= nil then
		UIS.MouseIconEnabled = savedMouseIcon
	end
	savedMouseBehavior = nil
	savedMouseIcon = nil
	refreshUI()
end

local function toggleMouse()
	if mouseUnlocked then lockMouse() else unlockMouse() end
end
