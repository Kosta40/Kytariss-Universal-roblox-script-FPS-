-- ============ KEYBINDS ============
UIS.InputBegan:Connect(function(input, processed)
	if processed then return end

	-- [NEW] Bloque le hold-lock si on est en train de cliquer sur un bouton du panel
	-- (évite de lock quand on clique sur les sliders/boutons)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		-- Si la souris est unlocked et qu'on clique sur le panel, on skip
		local mousePos = UIS:GetMouseLocation()
		local guiPos = frame.AbsolutePosition
		local guiSize = frame.AbsoluteSize
		local overPanel = mousePos.X >= guiPos.X and mousePos.X <= guiPos.X + guiSize.X
			and mousePos.Y >= guiPos.Y and mousePos.Y <= guiPos.Y + guiSize.Y
		if mouseUnlocked and overPanel then return end

		holdLocking = true
		holdMissingTime = 0
		if not target then
			local p = closest()
			if p then
				rememberedTarget = p
				setTarget(p)
			end
		end
		return
	end

	local k = input.KeyCode

	if k == Enum.KeyCode.Space and bunnyHop then
		startBunny()
	end

	if k == Enum.KeyCode.T then toggleLock()
	elseif k == Enum.KeyCode.E and target then cycle(1)
	elseif k == Enum.KeyCode.Q and target then cycle(-1)
	elseif k == Enum.KeyCode.B then
		boxOn = not boxOn
		refreshBoxes()
		refreshUI()
	elseif k == Enum.KeyCode.H then
		healthOn = not healthOn
		refreshHealth()
		refreshUI()
	elseif k == Enum.KeyCode.L then -- [NEW] toggle mouse
		toggleMouse()
	elseif k == Enum.KeyCode.G then setSpinBot(not spinning)
	elseif k == Enum.KeyCode.Insert then
		frame.Visible = not frame.Visible
		hint.Visible = frame.Visible
	elseif k == Enum.KeyCode.End then
		gui.Enabled = not gui.Enabled
		if not gui.Enabled then
			setTarget(nil)
			rememberedTarget = nil
			holdMissingTime = 0
			highlightOn = false
			boxOn = false
			healthOn = false
			stopSpinBot()
			stopBunny()
			lockMouse() -- [NEW]
			LOOK_ANGLE = 0
			lookSlider.setValue(0)
			refresh()
			refreshBoxes()
			refreshHealth()
			refreshUI()
		end
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		holdLocking = false
		rememberedTarget = nil
		holdMissingTime = 0
		if target then setTarget(nil) end
	end
	if input.KeyCode == Enum.KeyCode.Space then
		stopBunny()
	end
end)

