-- ============ HELPERS ============
local function head(p)
	local c = p and p.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then return c:FindFirstChild("Head") end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function isVisible(p)
	local h = head(p)
	if not h then return false end
	local origin = cam.CFrame.Position
	local dir = h.Position - origin
	local filter = {}
	if lp.Character then table.insert(filter, lp.Character) end
	if p.Character then table.insert(filter, p.Character) end
	rayParams.FilterDescendantsInstances = filter
	local hit = workspace:Raycast(origin, dir, rayParams)
	return hit == nil
end

local function isAliveOther(p)
	if p == lp then return false end
	if not head(p) then return false end
	return true
end

local function isValidESP(p) return isAliveOther(p) end
local function isValidLock(p) return isAliveOther(p) end

local function isVisibleForLock(p)
	if not isValidLock(p) then return false end
	if not isVisible(p) then return false end
	return true
end

local function inFOV(h)
	if not h then return false end
	local vp = cam.ViewportSize
	if vp.X == 0 or vp.Y == 0 then return false end
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local pos, onScreen = cam:WorldToViewportPoint(h.Position)
	if not onScreen then return false end
	local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
	return d <= FOV_RADIUS
end

local function apply(p)
	if not isValidESP(p) or not highlightOn or not p.Character then
		if highlights[p] then highlights[p]:Destroy() highlights[p] = nil end
		return
	end
	local h = highlights[p]
	if not h or h.Parent ~= p.Character then
		if h then h:Destroy() end
		h = Instance.new("Highlight")
		h.FillTransparency = 0.5
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = p.Character
		highlights[p] = h
	end
	h.FillColor = COLORS[colorIndex]
end

local function refresh()
	for _, p in ipairs(Players:GetPlayers()) do pcall(apply, p) end
end

local function detachLabel(p)
