local function others()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if isAliveOther(p) then table.insert(list, p) end
	end
	table.sort(list, function(a, b) return a.Name < b.Name end)
	return list
end

local function closest()
	local vp = cam.ViewportSize
	if vp.X == 0 or vp.Y == 0 then return nil end
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local best, bestD = nil, math.huge
	for _, p in ipairs(others()) do
		if isVisibleForLock(p) then
			local h = head(p)
			local pos, onScreen = cam:WorldToViewportPoint(h.Position)
			if onScreen then
				local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
				if d <= FOV_RADIUS and d < bestD then
					best, bestD = p, d
				end
			end
		end
	end
	return best
end

local function setTarget(p)
	target = p
	look = p and cam.CFrame.LookVector or nil
	refreshUI()
end

local function cycle(dir)
	local list = others()
	if #list == 0 then return setTarget(nil) end
	local i = table.find(list, target)
	if not i then return setTarget(list[1]) end
	setTarget(list[((i - 1 + dir) % #list) + 1])
end

local function toggleLock()
	if target then setTarget(nil) else setTarget(closest()) end
end

-- ============ SPIN BOT ============
local spinConnection = nil

local function stopSpinBot()
	spinning = false
	if spinConnection then spinConnection:Disconnect() spinConnection = nil end
	refreshUI()
end

local function startSpinBot()
	if spinning then return end
	spinning = true
	spinConnection = RunService.RenderStepped:Connect(function(dt)
		local char = lp.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return stopSpinBot() end
		local angle = math.rad(SPIN_SPEED * 60 * dt)
		hrp.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0)
	end)
	refreshUI()
end

local function setSpinBot(on)
	if on then startSpinBot() else stopSpinBot() end
end

